# Web server
AUTOFILM_HOST=0.0.0.0
AUTOFILM_PORT=3100
AUTOFILM_DATA_DIR=/data
AUTOFILM_PUBLIC_URL=http://localhost:3100
# URL reachable from chat Adapter containers when they fetch temporary media.
# AUTOFILM_MEDIA_BASE_URL=http://autofilm-core:3100
AUTOFILM_LOG_LEVEL=info

# Optional non-interactive owner bootstrap. Omit both values to use the setup UI.
# AUTOFILM_ADMIN_USERNAME=admin
# AUTOFILM_ADMIN_PASSWORD=replace-with-at-least-12-characters

# Required for encrypted provider, channel, and service credentials.
# Generate with: openssl rand -base64 32
AUTOFILM_MASTER_KEY=replace-with-a-random-32-byte-base64-key

# Optional first provider. New API is one possible supplier; any compatible URL works.
# AUTOFILM_BOOTSTRAP_AI_NAME=Primary AI
# AUTOFILM_BOOTSTRAP_AI_PROTOCOL=openai-responses
# AUTOFILM_BOOTSTRAP_AI_BASE_URL=https://your-provider.example/v1
# AUTOFILM_BOOTSTRAP_AI_API_KEY=
# AUTOFILM_BOOTSTRAP_AI_MODEL=
