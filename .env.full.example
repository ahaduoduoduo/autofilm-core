AUTOFILM_PORT=3100
OPENLIST_PORT=15244
JELLYFIN_PORT=18096

AUTOFILM_PUBLIC_URL=http://localhost:3100
OPENLIST_PUBLIC_URL=http://localhost:15244
AUTOFILM_WATCHLIST_INTERVAL_SECONDS=21600
# WeClaw discovery is configured by compose.full.yaml.

# Generate each value independently.
AUTOFILM_MASTER_KEY=
OPENLIST_JELLYFIN_TOKEN=
OPENLIST_JELLYFIN_EVENT_TOKEN=

# Optional headless Telegram initialization. The normal web setup does not
# require these values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CORE_TOKEN=
TELEGRAM_OUTBOUND_TOKEN=
TELEGRAM_PROVIDER_INSTANCE_ID=telegram-main
