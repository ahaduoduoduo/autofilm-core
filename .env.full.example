AUTOFILM_PORT=3100
OPENLIST_PORT=15244
JELLYFIN_PORT=18096

# Published images. Override with an immutable build tag or digest when needed.
AUTOFILM_CORE_IMAGE=ghcr.io/ahaduoduoduo/autofilm-core:latest
AUTOFILM_TELEGRAM_IMAGE=ghcr.io/ahaduoduoduo/autofilm-telegram-adapter:latest
AUTOFILM_OPENLIST_IMAGE=ghcr.io/ahaduoduoduo/autofilm-openlist-restic:sha-a8bd996869f7ddf11aa96ccac85170f76d92683b
AUTOFILM_JELLYFIN_IMAGE=ghcr.io/ahaduoduoduo/autofilm-jellyfin:latest
AUTOFILM_WECLAW_IMAGE=ghcr.io/ahaduoduoduo/weclaw:latest

AUTOFILM_PUBLIC_URL=http://localhost:3100
OPENLIST_PUBLIC_URL=http://localhost:15244
AUTOFILM_WATCHLIST_INTERVAL_SECONDS=21600
# WeClaw discovery is configured by compose.full.yaml.

# Host persistence roots. The production Synology keeps one top-level root per
# service under /volume1/docker.
AUTOFILM_CORE_DATA_DIR=/volume1/docker/autofilm-core
BACKREST_ROOT_DIR=/volume1/docker/backrest
WECLAW_DATA_DIR=/volume1/docker/weclaw
TELEGRAM_DATA_DIR=/volume1/docker/telegram-data
HOMEASSISTANT_DATA_DIR=/volume1/docker/homeassistant
OPENLIST_DATA_DIR=/volume1/docker/alist
JELLYFIN_CONFIG_DIR=/volume1/docker/jellyfin/config
JELLYFIN_CACHE_DIR=/volume1/docker/jellyfin/cache
JELLYFIN_MEDIA_DIR=/volume1/movie
JACKETT_CONFIG_DIR=/volume1/docker/Jackett

# Generate each value independently.
AUTOFILM_MASTER_KEY=
OPENLIST_JELLYFIN_TOKEN=
# Required only for OpenList's manual "scan in Jellyfin" action.
JELLYFIN_API_KEY=

# Optional headless Telegram initialization. The normal web setup does not
# require these values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CORE_TOKEN=
TELEGRAM_OUTBOUND_TOKEN=
TELEGRAM_PROVIDER_INSTANCE_ID=telegram-main
