FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json* tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/tsconfig.json ./packages/contracts/
COPY apps/telegram-adapter/package.json apps/telegram-adapter/tsconfig.json ./apps/telegram-adapter/
RUN npm install

COPY packages/contracts ./packages/contracts
COPY apps/telegram-adapter ./apps/telegram-adapter
RUN npm run build -w @autofilm/contracts \
    && npm run build -w @autofilm/telegram-adapter \
    && npm prune --omit=dev

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production \
    TELEGRAM_HOST=0.0.0.0 \
    TELEGRAM_PORT=18012 \
    TELEGRAM_DATA_DIR=/data
WORKDIR /app
RUN useradd --system --uid 10002 --create-home autofilm-telegram \
    && mkdir -p /data \
    && chown autofilm-telegram:autofilm-telegram /data

COPY --from=build --chown=autofilm-telegram:autofilm-telegram /app/package.json /app/package-lock.json ./
COPY --from=build --chown=autofilm-telegram:autofilm-telegram /app/node_modules ./node_modules
COPY --from=build --chown=autofilm-telegram:autofilm-telegram /app/apps/telegram-adapter/dist ./apps/telegram-adapter/dist
COPY --from=build --chown=autofilm-telegram:autofilm-telegram /app/apps/telegram-adapter/package.json ./apps/telegram-adapter/package.json
COPY --from=build --chown=autofilm-telegram:autofilm-telegram /app/packages/contracts/dist ./packages/contracts/dist
COPY --from=build --chown=autofilm-telegram:autofilm-telegram /app/packages/contracts/package.json ./packages/contracts/package.json

USER autofilm-telegram
VOLUME /data
EXPOSE 18012
CMD ["node", "apps/telegram-adapter/dist/index.js"]
